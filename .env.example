# PayReceipt environment — copy to .env and fill in. Never commit .env.

# mock runs everything locally; live talks to Aevum Testnet.
PAYRECEIPT_MODE=mock
PAYRECEIPT_AGENT_ID=payreceipt-agent-1
# Spend cap per invoice, in tUSD8 base units (6 decimals). 1000000000 = 1,000 tUSD8.
PAYRECEIPT_CAP_BASE_UNITS=1000000000
# Comma-separated payee addresses the agent must never approve.
PAYRECEIPT_DENYLIST=

# Aevum Testnet (QDay) — documented values, normally no need to change.
AEVUM_RPC_URL=https://rpc-test.qday.info
AEVUM_CHAIN_ID=44005
TUSD8_ADDRESS=0x456569838f1d43009A91ebA4263147Afd7233483

# Filled in after deployment (scripts/deploy.js prints them).
PAYEE_REGISTRY_ADDRESS=
INVOICE_ESCROW_ADDRESS=

# Keys — the entrant's own testnet wallets only. The deployer deploys the
# contracts; the agent key only ever signs release approvals (it holds no
# funds and cannot redirect payments).
DEPLOYER_PRIVATE_KEY=
AGENT_ADDRESS=
AGENT_PRIVATE_KEY=
